# Set this to the Raspberry Pi FastAPI server address (no trailing slash).
# Example: http://<pi-address>:8000
VITE_API_BASE_URL=

# Optional. How to read backend timestamps that have no time-zone suffix:
#   utc   (default) - e.g. Python datetime.utcnow().isoformat()
#   local           - e.g. Python datetime.now().isoformat()
# VITE_NAIVE_TIMESTAMPS=utc

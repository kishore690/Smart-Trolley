{
  "name": "cartly-smart-trolley",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0",
    "build": "vite build --configLoader native",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test \"tests/*.test.js\"",
    "android:init": "cap add android && node scripts/configure-android.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/configure-android.mjs",
    "android:open": "cap open android",
    "android:debug-apk": "npm run android:sync && node scripts/build-debug-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
